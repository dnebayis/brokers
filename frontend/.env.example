# Active network: "testnet" (46630) or "mainnet" (4663)
NEXT_PUBLIC_NETWORK=testnet

# Alchemy — dedicated RPC + NFT/Token APIs. The key is domain-restricted, so it is safe to
# expose client-side, BUT you must allowlist every HOST you serve from in the Alchemy app
# settings — Alchemy checks the BARE HOST, so add `localhost` (NOT http://localhost:3000) for
# dev and your bare domain (e.g. coattailbrokers.com) for prod, or the browser calls 403/CORS.
NEXT_PUBLIC_ALCHEMY_KEY=
NEXT_PUBLIC_RPC_URL_TESTNET=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_RPC_URL_MAINNET=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_ALCHEMY_NFT_BASE_TESTNET=https://robinhood-testnet.g.alchemy.com/nft/v3
NEXT_PUBLIC_ALCHEMY_NFT_BASE_MAINNET=https://robinhood-mainnet.g.alchemy.com/nft/v3

# WalletConnect Cloud project id (free): https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Congress feed keys are server-side only. Prefer a newly rotated Unusual Whales
# key; FMP is a fallback when its subscription includes House/Senate endpoints.
# Missing/rejected keys show OFFLINE and never fabricate sample rows.
UNUSUAL_WHALES_API_KEY=
FMP_API_KEY=
