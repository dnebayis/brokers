# coattail.cash stays on chain-46630 staging until a mainnet manifest and release gates are verified.
# Enter values in Vercel; never commit provider or feed secrets.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL_TESTNET=
NEXT_PUBLIC_RPC_URL_MAINNET=
NEXT_PUBLIC_ALCHEMY_KEY=
NEXT_PUBLIC_ALCHEMY_NFT_BASE_TESTNET=https://robinhood-testnet.g.alchemy.com/nft/v3
NEXT_PUBLIC_ALCHEMY_NFT_BASE_MAINNET=https://robinhood-mainnet.g.alchemy.com/nft/v3
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only variables used by the feed endpoint. Use UNUSUAL_WHALES_API_KEY when available;
# FMP_API_KEY is the fallback. Neither value is exposed to the browser.
# Never add PRIVATE_KEY, UPDATER_PRIVATE_KEY, KEEPER_PRIVATE_KEY or any owner key to Vercel.
UNUSUAL_WHALES_API_KEY=
FMP_API_KEY=
